# .env do site na VPS — copie para /opt/drterciorocha/.env e proteja com chmod 600.

# O mesmo valor de SITE_WEBHOOK_TOKEN no .env do painel (/opt/atendimento-tercio/.env):
# vai no header "Authorization: Bearer" de cada lead e de cada ficha da guia.
CRM_WEBHOOK_TOKEN=

# Endereço do painel. O padrão é o interno da rede do Docker; só mude se o painel sair desta VPS.
# CRM_WEBHOOK_URL=http://app:3000/api/webhooks/in/site

# Token da API de Conversões da Meta, gerado no Gerenciador de Eventos (pixel 621141566738202 →
# Configurações → API de Conversões → Gerar token de acesso). Sem ele, o site só usa o pixel no navegador.
META_CAPI_TOKEN=

# Painel /admin — quem pode entrar. Uma entrada por pessoa, separadas por vírgula, geradas na sua
# máquina com: node scripts/senha-painel.mjs email@dominio.com   (a senha em si não fica escrita aqui)
ADMIN_USUARIOS=

# Segredo que assina o login do painel. Gere uma vez com: openssl rand -hex 32
# Sem ele o painel funciona, mas cada nova publicação do site desconecta todo mundo.
ADMIN_SEGREDO=
