# Webhook do CRM que recebe os leads do formulário (a origem "site" do painel de atendimento).
# Sem esta variável o lead é apenas registrado no log do servidor — nada é perdido,
# mas nada chega ao CRM. Ver src/app/api/lead/route.ts e src/lib/crm.ts.
# A ficha da guia de exames (/guia → /api/guia) usa o mesmo endereço com "/site" trocado por "/guia".
CRM_WEBHOOK_URL=

# Opcional: enviado como "Authorization: Bearer <token>" na chamada ao CRM.
CRM_WEBHOOK_TOKEN=
